# RAGbase configuration — every value is optional.
# Local run:      cp .env.example .env   &&   python run.py
# Docker run:     cp .env.example .env   &&   docker compose up -d --build
# Everything unset => demo mode (retrieval + citations work, no API key needed).

# ---------------------------------------------------------------- host
# Host port published by docker-compose (container always listens on 8000)
RAGBASE_PORT=8000

# ---------------------------------------------------------------- security
# Leave empty: the Docker entrypoint generates one and stores it in the data
# volume. Set an explicit value when running outside Docker or across replicas.
RAGBASE_JWT_SECRET=
RAGBASE_JWT_EXPIRE_HOURS=72
# false => invite-only, registration closed after the admin account exists
RAGBASE_ALLOW_REGISTRATION=true

# ---------------------------------------------------------------- chat model
# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, Groq, Together, vLLM, Ollama…
# Leave the key empty for the offline demo engine.
RAGBASE_LLM_API_KEY=
RAGBASE_LLM_BASE_URL=https://api.openai.com/v1
RAGBASE_LLM_MODEL=gpt-4o-mini
# DeepSeek example:
# RAGBASE_LLM_BASE_URL=https://api.deepseek.com/v1
# RAGBASE_LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------- embeddings
# Leave the key empty to use local feature-hash vectors (BM25 still carries
# lexical search). Required only for high-quality semantic recall.
RAGBASE_EMBEDDING_API_KEY=
RAGBASE_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAGBASE_EMBEDDING_MODEL=text-embedding-3-small
RAGBASE_EMBEDDING_DIM=1536

# ---------------------------------------------------------------- limits
# 0 = unlimited documents per user
RAGBASE_MAX_DOCS_PER_USER=0
RAGBASE_MAX_UPLOAD_MB=25
RAGBASE_CHUNK_SIZE=900
RAGBASE_CHUNK_OVERLAP=150
RAGBASE_TOP_K=6
RAGBASE_RETRIEVAL_THRESHOLD=0.15

# ---------------------------------------------------------------- storage
# Only used when running outside Docker; the image pins /app/data.
RAGBASE_DATA_DIR=data
